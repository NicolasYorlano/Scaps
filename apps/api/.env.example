PORT=3000

# Cadena de conexión de tu base de Neon (ver "Base de datos" en el README).
# Copiala del panel con "Connection pooling" APAGADO: las migraciones de
# Prisma no funcionan sobre la conexión pooled.
DATABASE_URL=postgresql://neondb_owner:TU_PASSWORD@ep-xxxx-xxxx-00000000.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Base de los tests e2e: una RAMA del proyecto de Neon que ya tenés, no un
# proyecto nuevo (ver README). Borran datos, así que nunca es la de arriba.
DATABASE_URL_TEST=rama-de-tu-bd-llamada-test

JWT_SECRET=cambiar-por-un-secreto-real

# Credenciales del admin que crea el seed (prisma/seed.ts). Es el único camino
# para tener un admin: POST /auth/register siempre da de alta con es_admin en
# false. La clave va vacía a propósito: el seed no corre hasta que la completes.
ADMIN_EMAIL=admin@scaps.dev
ADMIN_PASSWORD=

# Orígenes que acepta CORS: desde dónde puede llamar el navegador a la API.
# Varios van separados por coma, y un * reemplaza un tramo sin puntos, para
# cubrir los previews de Vercel: https://scaps-*-<cuenta>.vercel.app
CORS_ORIGIN=http://localhost:5173

# URL pública del frontend. La usa el backend para armar las back_urls de
# Mercado Pago (éxito / error / pendiente). En local coincide con CORS_ORIGIN,
# pero son cosas distintas y en producción pueden no coincidir.
FRONTEND_URL=http://localhost:5173

# Mercado Pago (Sprint 3 — todavía sin usar)
MP_ACCESS_TOKEN=
# Secreto para validar la firma del webhook y confirmar que la llamada
# viene realmente de Mercado Pago.
MP_WEBHOOK_SECRET=

# Storage / Cloudflare R2: donde POST /uploads/model y POST /uploads/image
# guardan los archivos. Las seis son obligatorias: si falta alguna, la API no
# arranca. Las credenciales son las del token de desarrollo (scaps-api-dev), y
# se pasan por mensaje privado, nunca por el chat del grupo ni el repositorio.
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Endpoint S3 de tu cuenta de R2 (R2 es compatible con la API de S3):
# https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
# Base pública del CDN, sin barra al final: es el prefijo de las URLs que se
# guardan en Producto.glb_url y en ProductoImagen.url.
STORAGE_PUBLIC_URL=
# Carpeta del entorno dentro del bucket, con la barra final: dev/ en desarrollo
# y prod/ en Render. Todo lo que sube la API va ahí, y la API solo borra
# archivos de esa carpeta: los del seed, en la raíz, no se tocan.
STORAGE_KEY_PREFIX=dev/
