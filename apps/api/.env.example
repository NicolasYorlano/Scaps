PORT=3000
DATABASE_URL=postgresql://usuario:password@host:5432/scaps
JWT_SECRET=cambiar-por-un-secreto-real

# Origen que acepta CORS: desde dónde puede llamar el navegador a la API.
CORS_ORIGIN=http://localhost:5173

# URL pública del frontend. La usa el backend para armar las back_urls de
# Mercado Pago (éxito / error / pendiente). En local coincide con CORS_ORIGIN,
# pero son cosas distintas y en producción pueden no coincidir.
FRONTEND_URL=http://localhost:5173

# Mercado Pago (Sprint 3 — todavía sin usar)
MP_ACCESS_TOKEN=
# Secreto para validar la firma del webhook y confirmar que la llamada
# viene realmente de Mercado Pago.
MP_WEBHOOK_SECRET=

# Storage / Cloudflare R2 (Sprint 2 — todavía sin usar)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Endpoint S3 de tu cuenta de R2 (R2 es compatible con la API de S3).
STORAGE_ENDPOINT=
# Base pública del CDN: es el prefijo de las URLs que se guardan en
# Producto.glb_url y en ProductoImagen.url.
STORAGE_PUBLIC_URL=
